# Gemini API Web 部署模板
# 服务器部署前请复制为 .env，并修改下面的密码、密钥和允许来源。

# 管理端登录。只在本地可信环境才可以留空；服务器部署必须修改。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_COOKIE_SECURE=false

# 外部 /v1/* 接口鉴权。多个 API Key 使用英文逗号分隔。
REQUIRE_API_KEY=true
API_KEYS=sk-change-this-external-key

# 浏览器跨域来源。公网部署时改成你的面板或调用方域名。
CORS_ALLOW_ORIGINS=https://your-panel.example.com

# 账号轮换和请求超时。
SWITCH_ON_USES=40
FAILURE_THRESHOLD=3
IMMEDIATE_SWITCH_STATUS_CODES=429,503
REQUEST_TIMEOUT=300

# 可选构建标识，会显示在 /health 的 build.commit 中，方便确认服务器当前运行版本。
GIT_COMMIT=

# Cookie 自动刷新和网页登录授权浏览器。
GEMINI_AUTO_REFRESH=true
GEMINI_AUTH_HEADLESS=false

# 可选：媒体对象存储。开启后，生成的图片/视频/音频会上传到 S3 兼容存储并返回 Public URL。
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=gemini-web
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
