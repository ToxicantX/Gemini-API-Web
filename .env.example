# Gemini API Web deployment template
# Copy this file to .env before deploying on a server.

# Management console login. Keep empty only for local trusted development.
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# External API keys for /v1/* calls. Multiple keys can be separated by commas.
API_KEYS=sk-change-this-external-key

# Browser CORS allowlist. Use your real panel or app origin in production.
CORS_ALLOW_ORIGINS=https://your-panel.example.com

# Account rotation and timeout settings.
SWITCH_ON_USES=40
FAILURE_THRESHOLD=3
IMMEDIATE_SWITCH_STATUS_CODES=429,503
REQUEST_TIMEOUT=300

# Cookie refresh and web authorization browser settings.
GEMINI_AUTO_REFRESH=true
GEMINI_AUTH_HEADLESS=false
